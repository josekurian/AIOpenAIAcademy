FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ARG PARTNER_DISPLAY_NAME=HybridGenAI Academy
ARG PARTNER_DOMAIN=academy.hybridgenai.local
ARG PARTNER_CITY=Dallas–Fort Worth
ARG PARTNER_OPERATOR=Hybrid Cloud Services LLC
ARG PARTNER_STATUS=independent academy
ENV PARTNER_DISPLAY_NAME=$PARTNER_DISPLAY_NAME
ENV PARTNER_DOMAIN=$PARTNER_DOMAIN
ENV PARTNER_CITY=$PARTNER_CITY
ENV PARTNER_OPERATOR=$PARTNER_OPERATOR
ENV PARTNER_STATUS=$PARTNER_STATUS
RUN npm run build
EXPOSE 3000
CMD ["npm","run","start"]
